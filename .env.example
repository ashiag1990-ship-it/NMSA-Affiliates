# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nmsa_affiliate?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_NMSA_SITE_URL="https://nationalmsa.org"

# Email (stubbed — sending is logged to affiliate_email_events until a real
# provider is wired up in src/lib/email.ts). Fill these in when you're ready
# to connect Resend / SendGrid / Postmark / etc.
EMAIL_PROVIDER="stub"
EMAIL_FROM="NMSA Affiliate Program <affiliates@nationalmsa.org>"
EMAIL_API_KEY=""

# Webhook shared secret — the main NMSA site (or whatever system records
# registrations/enrollments/purchases) must send this in an
# `x-nmsa-webhook-secret` header when calling the /api/webhooks/nmsa/* routes.
NMSA_WEBHOOK_SECRET="replace-with-a-long-random-string"

# Cron shared secret — protects /api/cron/monthly-payout from being called
# by anyone other than your scheduler (e.g. a Vercel Cron job or crontab curl).
CRON_SECRET="replace-with-a-long-random-string"

# Seed / bootstrap admin
SEED_ADMIN_EMAIL="admin@nationalmsa.org"
SEED_ADMIN_PASSWORD="ChangeMe123!"
